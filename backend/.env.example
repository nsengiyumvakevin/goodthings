PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/transaction_app
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_ORIGIN=http://localhost:5173

# Google Identity Services (OAuth 2.0)
GOOGLE_CLIENT_ID=

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-password
ADMIN_FULL_NAME=Store Administrator

# Gmail / Google Workspace (recommended): create an App Password at
# https://myaccount.google.com/apppasswords and use it as SMTP_PASSWORD.
SMTP_SERVICE=gmail
SMTP_USER=your-address@gmail.com
SMTP_PASSWORD=your-16-character-google-app-password
SMTP_FROM=your-address@gmail.com

# Generic SMTP alternative (used when SMTP_SERVICE is empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false




# MTN MoMo (Collection)
MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MOMO_TARGET_ENV=sandbox
MOMO_SUBSCRIPTION_KEY=replace-with-your-collection-subscription-key
MOMO_API_USER=replace-with-your-sandbox-api-user
MOMO_API_KEY=key_generated_for_that_user
MOMO_CALLBACK_URL=https://your-public-https-host/api/momo/callback
MOMO_CURRENCY=RWF

# Reporting timezone used for daily income/outcome reports
REPORT_TIMEZONE=Africa/Kigali
